APP_NAME=a2a-demo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://coordinator.a2a-demo.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# A2A — two HTTPS hosts (Laravel Herd: worker.a2a-demo.test and coordinator.a2a-demo.test)
A2A_ROLE=coordinator
A2A_WORKER_URL=https://worker.a2a-demo.test
A2A_COORDINATOR_URL=https://coordinator.a2a-demo.test
A2A_BASE_URL=https://coordinator.a2a-demo.test
A2A_STORE=memory
A2A_QUEUE=false
A2A_AUTH=false
A2A_PATH=
A2A_NAME=
A2A_DESCRIPTION=
A2A_VERSION=0.1.0
A2A_EXECUTOR=
A2A_AGENT=
A2A_FILE_STORE=
A2A_QUEUE_CONNECTION=
A2A_QUEUE_NAME=a2a
A2A_QUEUE_TIMEOUT=30
A2A_AUTH_GUARD=sanctum
A2A_SUBSCRIBE_TIMEOUT=15

# Laravel AI SDK. Default provider is OpenRouter. Keys stay empty — never commit secrets.
AI_DEFAULT_PROVIDER=openrouter
A2A_DEMO_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_API_KEY=
# OPENROUTER_URL=https://openrouter.ai/api/v1

# Optional alternative: AI_DEFAULT_PROVIDER=openai with OPENAI_API_KEY and an OpenAI model id in A2A_DEMO_MODEL.
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=
AWS_BEARER_TOKEN_BEDROCK=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/
GROQ_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_URL=
TYPESAFE_API_KEY=
VOYAGEAI_API_KEY=
XAI_API_KEY=
